{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": []
  },
  "include": [
    "src/**/*",
    "content/**/*",
    "scripts/**/*",
    "lib/**/*",
    "tests/**/*",
    ".astro/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "runner",
    "legacy"
  ]
}
