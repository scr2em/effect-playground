{
  "name": "effect-playground",
  "version": "0.1.0",
  "description": "Interactive course for Effect v4 (TypeScript): plain-English lessons, fix-the-code challenges, build-it problems, and recall cards, with real type checking and execution in the browser",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scr2em/effect-playground.git"
  },
  "homepage": "https://github.com/scr2em/effect-playground#readme",
  "keywords": [
    "effect",
    "effect-ts",
    "typescript",
    "learning",
    "playground",
    "course"
  ],
  "bin": {
    "effect-playground": "bin/effect-playground.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:assets && astro build",
    "preview": "astro preview",
    "verify": "node --import tsx scripts/verify.ts",
    "start": "node bin/effect-playground.js",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:assets": "node scripts/build-effect-bundle.mjs && node scripts/build-effect-types.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@stylexjs/stylex": "0.19.0",
    "astro": "7.3.1",
    "effect": "4.0.0-rc.112",
    "marked": "12.0.2",
    "monaco-editor": "0.52.2",
    "react": "19",
    "react-dom": "19",
    "shiki": "4.4.3",
    "tsx": "4.23.13",
    "typescript-js": "npm:typescript@6.0.3"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
