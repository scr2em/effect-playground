---
/**
 * Section list with progress badges. Counts live in localStorage, so the badges are
 * filled in client-side (src/client/app.ts) from data-items.
 */
import * as stylex from "@stylexjs/stylex"
import type { Section } from "../../content/types.ts"
import { sidebar } from "../styles/sidebar.stylex"

interface Props { sections: Array<Section>; current?: string }
const { sections, current } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---
<aside id="sidebar" {...stylex.props(sidebar.root)}>
  <div {...stylex.props(sidebar.brand)}>
    <div {...stylex.props(sidebar.brandTitle)}><a href={`${base}/`} {...stylex.props(sidebar.brandLink)}>Effect Playground</a></div>
    <div {...stylex.props(sidebar.brandSub)}>v4.0.0-rc.112 · learn by fixing and building</div>
  </div>
  <nav id="nav" {...stylex.props(sidebar.nav)}>
    {sections.map((s) => {
      const items = [...s.challenges, ...s.problems].map((i) => i.id)
      return (
        <a href={`${base}/${s.id}/`} data-section={s.id} data-items={items.join(",")} {...stylex.props(sidebar.link, s.id === current && sidebar.linkActive)}>
          <span>{s.title}</span>
          <span data-badge {...stylex.props(sidebar.badge)}></span>
        </a>
      )
    })}
  </nav>
  <div {...stylex.props(sidebar.foot)}>
    <a href={`${base}/scratch/`} {...stylex.props(sidebar.footLink, current === "scratch" && sidebar.footLinkActive)}>Scratchpad</a>
    <button type="button" id="reset-progress" {...stylex.props(sidebar.footLink, sidebar.danger)}>Reset progress</button>
  </div>
</aside>
