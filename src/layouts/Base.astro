---
import "../styles/global.css"
import * as stylex from "@stylexjs/stylex"
import type { Section } from "../../content/types.ts"
import Sidebar from "../components/Sidebar.astro"
import { layout } from "../styles/layout.stylex"
import { markdownCss } from "../styles/markdown-css"
import { lightThemeClass, THEME_KEY, LIGHT_QUERY } from "../client/theme"

interface Props { title: string; sections: Array<Section>; current?: string }
const { title, sections, current } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Effect Playground</title>
    <meta name="color-scheme" content="dark light" />
    {/* Theme before first paint: same rules as src/client/theme.ts (stored choice, else the OS preference). */}
    <script is:inline define:vars={{ lightThemeClass, THEME_KEY, LIGHT_QUERY }}>
      (function () {
        var mode = null
        try { mode = localStorage.getItem(THEME_KEY) } catch (e) {}
        var theme = mode === "light" || mode === "dark" ? mode : (matchMedia(LIGHT_QUERY).matches ? "light" : "dark")
        var root = document.documentElement
        if (theme === "light") root.classList.add.apply(root.classList, lightThemeClass.split(" "))
        root.dataset.theme = theme
        root.style.colorScheme = theme
      })()
    </script>
    {import.meta.env.DEV && (
      <>
        {/* StyleX dev CSS endpoint + HMR shim (unplugin README); production links the emitted asset. */}
        <link rel="stylesheet" href="/virtual:stylex.css" />
        <script is:inline type="module" src="/@id/virtual:stylex:css-only"></script>
      </>
    )}
    <style is:inline set:html={markdownCss}></style>
  </head>
  <body {...stylex.props(layout.body)}>
    <button type="button" id="sidebar-toggle" aria-controls="sidebar" aria-expanded="false" {...stylex.props(layout.sidebarToggle)}>☰ Sections</button>
    <div {...stylex.props(layout.app)}>
      <Sidebar sections={sections} current={current} />
      <main id="main" {...stylex.props(layout.main)}>
        <div id="content" {...stylex.props(layout.content)}><slot /></div>
      </main>
    </div>
    <script>
      import "../client/app.ts"
    </script>
  </body>
</html>
